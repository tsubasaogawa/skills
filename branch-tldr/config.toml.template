[output]
# Maximum characters per bullet body (excluding the leading "- ").
# Full-width and half-width characters both count as one.
max_line_length = 100
# Extra instruction about writing style. Leave empty to use only the built-in rules.
style = "日本語の場合は常体 (だ・である調) を使う。"
# Reader's technical background: "high" (engineers in this area), "medium" (engineers new to this change), "low" (general engineers), or "minimum" (non-engineers).
# The wording for levels other than "high" is produced by the expertise-rewriter agent.
# The --expertise argument overrides this value for a single run.
expertise = "medium"
