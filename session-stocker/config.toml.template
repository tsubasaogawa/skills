[artifacts]
directory = ""
# Set to true when `directory` is a folder inside an Obsidian vault.
# The note is then created through the Obsidian CLI, which requires Obsidian to be running.
use_obsidian_cli = false
# Name an Obsidian vault to skip directory-based auto-detection and always use
# that vault. When set, `directory` is treated as a vault-relative folder path
# instead of an absolute filesystem path. Leave empty to auto-detect from `directory`.
vault_name = ""
