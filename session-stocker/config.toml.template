[artifacts]
# With use_obsidian_cli = false: an absolute filesystem path.
# With use_obsidian_cli = true: a folder path relative to the vault root
# (leave empty to save at the vault root).
directory = ""
# Set to true when notes should be saved into an Obsidian vault.
# The note is then written into the vault by scripts/obsidian_stock.py.
# Obsidian needs to be running only when vault_name is empty.
use_obsidian_cli = false
# Name the Obsidian vault to save into. Only used when use_obsidian_cli = true.
# Leave empty to use whichever vault Obsidian currently has focused.
vault_name = ""
# Optional Markdown template the note is rendered from (see "Template mode" in SKILL.md).
# Resolved the same way as directory: an absolute path with use_obsidian_cli = false,
# a vault-relative path with use_obsidian_cli = true. Leave empty to use the built-in layout.
template = ""
